AWS_REGION=ap-south-1
DYNAMODB_TABLE=yieldsense
S3_BUCKET=replace-with-your-private-bucket
API_KEY=replace-with-a-random-secret-at-least-32-characters
LISTEN_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
# CPU model worker implementing docs/ml-integration.md; blank disables predictions.
ML_INFERENCE_URL=
ML_INFERENCE_TOKEN=
DEFAULT_MODEL_VERSION=
